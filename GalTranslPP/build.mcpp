import std;
import mcpp;
import mcpp.deps.vcpkg;
import mcpp.rules.qt;

#include "../mcpp-build-scripts/gpp_deps.hpp"

int main() {
    track_build_scripts();
    // The core library links the vcpkg libraries for every member that uses it.
    if (!use_vcpkg({"7zip", "bit7z64", "abseil_dll", "cld3", "cpr", "gumbo",
                    "icuio", "icuin", "icuuc", "icudt", "libprotobuf-lite", "fmt",
                    "lua", "mecab", "opencc", "pcre2-8", "spdlog", "tree-sitter",
                    "zip", "z"}))
        return 1;

    // The embedded Python the pybind11 submodule carries: a runtime search
    // directory of every program linking the core, for `mcpp run`, `mcpp pack`
    // and the DLLs mcpp places beside a program after its link.
    mcpp::runtime_search_dir("../3rdParty/pybind11/bin");
    // 7z.dll (bit7z loads it at run time) from the xim:7zip payload this
    // member declares, beside every program linking the core.
    if (const std::string sevenZip = mcpp::xpkg_dir("xim", "7zip"); !sevenZip.empty())
        mcpp::deploy((std::filesystem::path(sevenZip) / "7z.dll").generic_string().c_str(), ".");

    mcpp::rules::qt::options qt;
    qt.modules = {"Core"};
    qt.deploy_plugins = {};
    // The core's QM file is written beside its TS file, where each release
    // layout copies it from.
    qt.i18n = gpp_translations("qt_gpp_en.ts", ".");
    return mcpp::rules::qt::compile(qt) ? 0 : 1;
}
