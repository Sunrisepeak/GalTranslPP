import std;
import mcpp;
import mcpp.deps.vcpkg;
import mcpp.rules.qt;
import gpp.build;

int main() {
    // The updater does not link the core, so it links bit7z itself.
    if (!gpp::use_vcpkg({"7zip", "bit7z64"})) return 1;
    mcpp::rules::qt::options qt;
    qt.modules = {"Core", "Gui", "Widgets"};
    qt.deploy_plugins = {"platforms", "styles", "imageformats"};
    qt.i18n = gpp::i18n("qt_gppupdater_en.ts");
    if (!mcpp::rules::qt::compile(qt)) return 1;
    gpp::executable_actions actions("Updater");
    return actions.publish_release("Updater", gpp::qm_path("qt_gppupdater_en")) ? 0 : 1;
}
