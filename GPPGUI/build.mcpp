import std;
import mcpp;
import mcpp.deps.vcpkg;
import mcpp.deps.cmake;
import mcpp.rules.qt;
import gpp.build;

int main() {
    if (!gpp::use_vcpkg()) return 1;

    mcpp::rules::qt::options qt;
    qt.modules = {"Core", "Gui", "Network", "Widgets"};
    qt.deploy_plugins = {"platforms", "styles", "imageformats"};
    qt.resources = {"GPPGUI.qrc"};
    qt.i18n = gpp::i18n("qt_gppgui_en.ts");
    if (!mcpp::rules::qt::compile(qt)) return 1;

    // ElaWidgetTools, the widget library the GUI is built on, as a CMake
    // subproject configured against the same Qt SDK.
    mcpp::deps::cmake::options ela;
    ela.source = "../3rdParty/ElaWidgetTools";
    ela.cache_args = {"-DQT_SDK_DIR=" + mcpp::rules::qt::root(),
                      "-DELAWIDGETTOOLS_BUILD_EXAMPLE=OFF"};
    ela.dirs = {.include = "ElaWidgetTools/include", .lib = "ElaWidgetTools/lib",
                .bin = "ElaWidgetTools/bin"};
    ela.libraries = {"ElaWidgetTools"};
    ela.shared = true;
    const auto elaPrefix = mcpp::deps::cmake::use(ela);
    if (!elaPrefix) return 1;

    const char* updater = mcpp::dep_bin("gpp.updater", "Updater");
    if (!updater || !*updater) {
        std::cerr << "Updater build dependency produced no executable\n";
        return 1;
    }
    gpp::executable_actions actions("GalTranslPP_GUI");
    actions.extra_runtime_dirs.push_back(elaPrefix.bin);
    if (!actions.publish_release("GPPGUI", gpp::qm_path("qt_gppgui_en"))) return 1;
    if (const auto profile = std::string_view(mcpp::profile());
        profile == "release" || profile == "fast-release") {
        actions.copy(updater, actions.release / "GPPGUI" / "Updater.exe");
        actions.copy(updater, actions.release / "GUICORE" / "Updater_new.exe");
        const auto private_dir = actions.private_release_dir("GPPGUI");
        if (!private_dir.empty())
            actions.copy(updater, private_dir / "Updater_new.exe");
    }
    return 0;
}
